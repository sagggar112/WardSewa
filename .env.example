APP_NAME=WardSewa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu
APP_URL=http://localhost:8000

APP_LOCALE=ne
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wardsewa
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@wardsewa.gov.np"
MAIL_FROM_NAME="${APP_NAME}"

# WardSewa Real-Time SMS Gateway (Nepal & International)
# Supported SMS_PROVIDER options: log, sparrow, aakash, twilio, generic
SMS_PROVIDER=log
SMS_FROM="WardSewa"
SMS_DEBUG=false

# 1. Sparrow SMS (Nepal - https://sparrowsms.com)
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM="WardSewa"

# 2. Aakash SMS (Nepal - https://aakashsms.com)
AAKASH_SMS_TOKEN=

# 3. Twilio (International / Nepal with +977)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 4. Generic Custom HTTP Gateway
SMS_GENERIC_URL=
SMS_GENERIC_TOKEN=

# Khalti Payment Gateway
KHALTI_PUBLIC_KEY=test_public_key_dc74e0fd57cb46cd93832aee0a505b8e
KHALTI_SECRET_KEY=test_secret_key_f59e8b7d18b24b9993e168c81884c55b
KHALTI_BASE_URL=https://a.khalti.com/api/v2/
